  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-ext-applet-cheatsheet</binary>
  </provides>
  <categories>
    <category>Utility</category>
  </categories>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.0" date="2026-07-26" />
  </releases>
